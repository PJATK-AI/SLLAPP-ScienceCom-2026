{
    "$schema": "./node_modules/turbo/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
            "outputs": ["dist/**"]
        },
        "transit": {
            "dependsOn": ["^transit"]
        },
        "typecheck": {
            "dependsOn": ["^transit"]
        },
        "test": {
            "dependsOn": ["^transit"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
